# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Portable Node.js for offline PCs (jalankan.bat looks here first). Copied in,
# never committed: 90+ MB of binaries for one operating system.
/node
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# The negation above matches that one name exactly, so every other template has
# to be named too — without a line of its own, .env.onprem.example is ignored
# like a real secrets file, and a template nobody can commit helps nobody.
!.env.onprem.example
# The demo defaults for `npm run dev`, which the container also reads because
# it runs `next dev`. Holds no secrets — placeholders only, no directory —
# and is committed so a fresh clone runs without any setup.
!.env.development

# local JSON data store
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Regenerated by Next.js at install; CLAUDE.md points at it.
/AGENTS.md

# One-off scripts kept locally: the codemod that replaced the native selects
# lives here. Used once, imported by nothing, not part of the application.
/scratch
