# PC kantor: copy these entries into the ignored .env.local without replacing
# the local demo/email settings already there. Start with read-only validation.

MOCK_AD_LOGIN=false
AD_DRIVER=ldap
AD_LDAP_WRITE_ENABLED=false

# Use the approved DC DNS name (matching its TLS certificate), not an IP address.
LDAP_URL=ldaps://dc.example.internal:636
AD_LDAP_URL=ldaps://dc.example.internal:636
LDAP_DOMAIN=example.internal
LDAP_BASE_DN=DC=example,DC=internal
AD_BASE_DN=DC=example,DC=internal
LDAP_CA_CERT_PATH=C:\certs\corp-root-ca.pem
LDAP_NESTED_GROUPS=false

# Service identity is separate from the user who signs in. Enter its password
# directly into the ignored .env.local; never send it in chat or commit it.
AD_BIND_DN=CN=svc-hc-portal,OU=Service Accounts,DC=example,DC=internal
AD_BIND_PASSWORD=

# Stage 2 is read-only: keep the allow-list empty and write switch false.
# For stage 3, replace this with ONLY the pilot OU and its quarantine OU,
# include both in AD_MANAGED_OUS, then enable writes after read-only checks pass.
AD_MANAGED_OUS=
AD_QUARANTINE_OU=
AD_GROUP_HC=
AD_GROUP_ADMIN=
AD_GROUP_OPS=
AD_GROUP_AUDITOR=
CISO_APPROVER_GROUP=

# Fill the directory access catalogue. It must be configured before using the
# portal's real LDAP worker; example-domain defaults are blocked for AD_DRIVER=ldap.
AD_OU_STANDARD=
AD_OU_ENGINEERING=
AD_OU_FINANCE=
AD_OU_SECURITY=
AD_ACCESS_GROUP_BASE=
AD_ACCESS_GROUP_ENGINEERING=
AD_ACCESS_GROUP_FINANCE=
AD_ACCESS_GROUP_SECURITY=

# Keep the inherited local EMAIL_DRIVER=file for stage 2. For stage 3, use the
# approved mail relay and set EMAIL_REDIRECT_TO to the pilot tester so approval
# tokens never reach real managers/CISO recipients during testing.
EMAIL_DRIVER=file
EMAIL_REDIRECT_TO=
