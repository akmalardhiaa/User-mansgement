# Copy to .env.docker, then fill in the two secrets marked below.
#
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored and is excluded from the Docker build context, so it
# never enters an image layer — docker-compose.yml reads it at run time instead.
#
# This is the DEMO configuration. See the comment block at the top of the
# Dockerfile for why the container runs in development mode and what a
# production deployment would need instead.

# ---------------------------------------------------------------------------
# Where the app thinks it is
# ---------------------------------------------------------------------------
# Must match the URL you actually open in the browser, including the port.
# Every approval email builds its links from this value, so a mismatch produces
# mail whose buttons point at nothing.
APP_BASE_URL=http://localhost:3000

# Inside the container this is where the bind mount lands. Leave it alone unless
# you also change the volume in docker-compose.yml.
HC_DATA_FILE=data/hc-store.json

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_LOGO=/brand/mandiri-sekuritas-lockup.png
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas

# ---------------------------------------------------------------------------
# Signing in — the simulated directory
# ---------------------------------------------------------------------------
# Roles come from each account's group membership in data/mock-ad.json, through
# the same mapping a real domain controller's memberOf goes through.
#
# The three accounts below hold roles because `npm run mock-ad:roles` granted
# them. If the directory you mount has not been seeded, everyone signs in with
# no roles and sees only their own profile — run that command on the host first.
#
#   ayu.prameswari   HC_REQUESTER + SYSTEM_ADMIN
#   sarah.wijaya     MANAGER
#   bagus.nugroho    CISO_APPROVER
#
# The demo accounts in src/lib/auth/devUsers.ts still work too: a name the
# directory does not recognise falls through to that list.
MOCK_AD_LOGIN=true
MOCK_AD_PASSWORD=mock12345

# These four must match the DNs written into the simulated directory. The seeder
# reads them, so keeping both sides in one file is what stops them drifting.
AD_GROUP_HC=CN=HC Officers,OU=Groups,DC=corp,DC=example,DC=com
AD_GROUP_ADMIN=CN=HC Portal Admins,OU=Groups,DC=corp,DC=example,DC=com
AD_GROUP_MANAGER=CN=Division Managers,OU=Groups,DC=corp,DC=example,DC=com
AD_GROUP_CISO=CN=IT Security Approvers,OU=Groups,DC=corp,DC=example,DC=com

# ---------------------------------------------------------------------------
# Execution against the directory
# ---------------------------------------------------------------------------
# The simulated driver. `ldap` is not implemented; the on-premise worker is a
# separate piece of work.
AD_DRIVER=mock

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# `file` writes each message to data/outbox-mail as HTML you can open — no
# mailbox needed, and nothing leaves the machine. Switch to `smtp` and fill in
# the block below to send for real.
EMAIL_DRIVER=file

# THE SAFETY NET. With this set, every approval email goes to this one address
# instead of the person it was addressed to. The demo directory contains real
# third-party addresses, and an approval email carries a single-use token that
# lets whoever holds it approve a termination. Leave this set unless you have
# checked every recipient by hand.
EMAIL_REDIRECT_TO=ganti-dengan-email-anda@example.com

# --- SMTP, only when EMAIL_DRIVER=smtp -------------------------------------
# For Gmail this is a 16-character App Password with no spaces, and it requires
# 2-Step Verification on the account. An ordinary password will not work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_SENDER=
# SMTP_PASSWORD=          # <-- SECRET. Never commit this file.

# ---------------------------------------------------------------------------
# Approval routing
# ---------------------------------------------------------------------------
# The second approver. HC never types an approver's address; the manager comes
# from the employee's record and the CISO comes from here.
CISO_APPROVER_EMAIL=ganti-dengan-email-ciso@example.com
CISO_APPROVER_NAME=Approver CISO

# ---------------------------------------------------------------------------
# Outbox
# ---------------------------------------------------------------------------
# How often the queue is swept, in seconds. 0 or `off` disables it and leaves
# sending to the button in the UI.
OUTBOX_POLL_SECONDS=30

# Encrypts the queued message payloads, which hold live approval tokens until
# each message is sent. Outside production a fixed demo key is derived when this
# is unset — that key is public, so set a real one if this container is reachable
# by anyone but you:
#
#   openssl rand -base64 32
#
# OUTBOX_ENCRYPTION_KEY=
