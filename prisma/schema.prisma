// Prisma schema for the account system that fronts the HC dashboard.
//
// This table is the single source of truth for "who may sign in". The HC
// domain model (employees, access requests) still lives in src/lib/db and is
// keyed by email, so an account here and an employee record there are related
// by email address rather than a foreign key — the two stores are deliberately
// separate, and an employee can exist long before anyone gives them a login.

datasource db {
  provider = "postgresql"
  // No `url` here: Prisma 7 takes the connection string from prisma.config.ts
  // for CLI commands, and from the driver adapter for the runtime client.
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id         String  @id @default(cuid())
  email      String  @unique
  /// bcrypt hash — never the plaintext. Length is validated in
  /// src/lib/validation/accountInput.ts (min 8 chars) before hashing, because
  /// the hash is always 60 chars and a database constraint could not see it.
  password   String
  fullName   String
  role       Role    @default(USER)
  /// Set by the approval workflow. Absent on accounts created before it existed.
  department String?

  emailVerified Boolean @default(false)

  /// Random 32-byte hex, cleared once used. Unique so a token maps to at most
  /// one account and a lookup can be a single indexed read.
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  /// Same shape as the verification token, on its own 1-hour clock.
  resetToken        String?   @unique
  resetTokenExpires DateTime?

  /// Approval requests that would activate this account.
  approvalRequests   UserApprovalRequest[] @relation("ApprovalSubject")
  /// Approval requests this account (an HC admin) submitted for someone else.
  submittedApprovals UserApprovalRequest[] @relation("ApprovalRequester")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// Where a new account is in the approval chain. Rejections are terminal.
enum ApprovalStatus {
  PENDING
  MANAGER_APPROVED
  MANAGER_REJECTED
  IT_APPROVED
  IT_REJECTED
  ACTIVE
}

/// One request to activate one account, decided by a manager and then the CISO.
///
/// Tokens are stored as SHA-256 hashes, never raw: a leaked table must not hand
/// out working approval links. Each role has its own token, so the manager link
/// can never be used to approve as the CISO.
model UserApprovalRequest {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation("ApprovalSubject", fields: [userId], references: [id], onDelete: Cascade)
  status ApprovalStatus @default(PENDING)

  department String
  notes      String?

  managerName  String
  managerEmail String
  cisoName     String
  cisoEmail    String

  managerTokenHash      String?   @unique
  managerTokenExpiresAt DateTime?
  managerTokenUsedAt    DateTime?

  /// Issued only once the manager approves, so its 24 hours start then.
  cisoTokenHash      String?   @unique
  cisoTokenExpiresAt DateTime?
  cisoTokenUsedAt    DateTime?

  managerApprovedAt DateTime?
  cisoApprovedAt    DateTime?
  activatedAt       DateTime?

  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  /// The HC admin who submitted it. Name and email are copied so the rejection
  /// email still reaches them even if their account is later removed.
  requestedById  String?
  requestedBy    User?   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requesterName  String
  requesterEmail String

  logs ApprovalLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

/// Append-only audit trail. Rows are written, never updated.
model ApprovalLog {
  id                String              @id @default(cuid())
  approvalRequestId String
  approvalRequest   UserApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  action            String
  actionBy          String
  details           String?
  timestamp         DateTime            @default(now())

  @@index([approvalRequestId, timestamp])
}

/// The mailbox the app sends from, connected once by an admin through OAuth.
///
/// One row per provider. Tokens are AES-256-GCM encrypted at rest with a key
/// derived from JWT_SECRET, so a leaked table cannot send mail as the account.
model EmailConnection {
  id                   String    @id
  provider             String
  accountEmail         String
  displayName          String?
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  connectedById        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
