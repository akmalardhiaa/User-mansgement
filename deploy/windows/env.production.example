# Salin ke .env.production.local lalu ganti SEMUA <...> dengan nilai yang disetujui.
# Jangan commit file .env.production.local atau menaruh kredensial nyata di git,
# dan jangan kirim isinya lewat chat.
#
# Path di bawah adalah path DI DALAM container (/app/data, /run/certs), bukan
# C:\... — compose.production.yml memetakan ./certs ke /run/certs dan volume
# hc-data ke /app/data. Panduan langkah demi langkah: PANDUAN-PC-KANTOR.md.

# --- Alamat portal ----------------------------------------------------------
# Alamat https yang dibuka staf HC dan manajer (lewat IIS). Setiap link
# persetujuan di email dibangun dari nilai ini, jadi harus bisa dibuka dari PC
# manajer, bukan localhost.
APP_BASE_URL=https://<nama-host-portal>
NEXT_PUBLIC_BRAND_LOGO=/brand/<logo-perusahaan>.png
NEXT_PUBLIC_BRAND_NAME=<nama-perusahaan>

# --- Active Directory: login --------------------------------------------------
LDAP_URL=ldaps://<nama-host-dc>:636
AD_LDAP_URL=ldaps://<nama-host-dc>:636
LDAP_DOMAIN=<domain-upn>
LDAP_BASE_DN=<base-dn>
AD_BASE_DN=<base-dn>
LDAP_CA_CERT_PATH=/run/certs/corp-root-ca.pem
LDAP_NESTED_GROUPS=false

# --- Active Directory: akun layanan (yang menulis ke AD) ----------------------
AD_DRIVER=ldap
# false dulu. Nyalakan (true) hanya setelah /status-ad semuanya OK.
AD_LDAP_WRITE_ENABLED=false
AD_BIND_DN=<dn-akun-service>
AD_BIND_PASSWORD=<kata-sandi-akun-service>
AD_MANAGED_OUS=<dn-ou-kelola-1>;<dn-ou-kelola-2>
AD_QUARANTINE_OU=<dn-ou-karantina>

# --- Siapa boleh masuk portal (group AD) --------------------------------------
AD_GROUP_HC=<dn-group-hc>
AD_GROUP_ADMIN=<dn-group-admin>
AD_GROUP_OPS=<dn-group-operator>
AD_GROUP_AUDITOR=<dn-group-auditor>
LDAP_ADMIN_GROUP=<dn-group-admin>

# --- OU dan group akses -------------------------------------------------------
AD_OU_STANDARD=<dn-ou-karyawan>
AD_OU_ENGINEERING=<dn-ou-engineering>
AD_OU_FINANCE=<dn-ou-finance>
AD_OU_SECURITY=<dn-ou-security>
AD_ACCESS_GROUP_BASE=<dn-group-akses-dasar>
AD_ACCESS_GROUP_ENGINEERING=<dn-group-akses-engineering>
AD_ACCESS_GROUP_FINANCE=<dn-group-akses-finance>
AD_ACCESS_GROUP_SECURITY=<dn-group-akses-security>

# OU per divisi (opsional; kosong = semua akun baru ke AD_OU_STANDARD).
# Bentuk: Divisi=>DN OU;Divisi=>DN OU - lihat .env.example.
AD_DEPARTMENT_OUS=
AD_DEPARTMENT_OU_PARENT=

# Sinkronisasi karyawan dari AD (otomatis, hanya membaca); kosong = seluruh base DN.
AD_SYNC_OUS=
AD_SYNC_MINUTES=15

# --- Email --------------------------------------------------------------------
# Terkirim saat itu juga begitu ada pengajuan/persetujuan. /status-ad menguji
# koneksi dan login SMTP sungguhan tanpa mengirim email.
EMAIL_DRIVER=smtp
# Harus KOSONG di kantor (production menolak nilai apa pun di sini).
EMAIL_REDIRECT_TO=
SMTP_HOST=<host-smtp>
# 587 (STARTTLS), 465 (TLS langsung), atau 25 untuk relay internal.
SMTP_PORT=587
# Relay kantor tanpa login: kosongkan SMTP_USER DAN SMTP_PASSWORD, isi SMTP_SENDER.
SMTP_USER=<akun-smtp>
SMTP_PASSWORD=<kata-sandi-smtp>
SMTP_SENDER=<alamat-pengirim>
# required = wajib terenkripsi (disarankan). off hanya untuk relay tanpa TLS dan tanpa login.
SMTP_TLS=required
# Isi bila relay memakai sertifikat dari CA kantor (biasanya file yang sama dengan LDAP).
SMTP_CA_CERT_PATH=
CISO_APPROVER_GROUP=<dn-group-ciso>
CISO_APPROVER_EMAILS=
CISO_EXCLUDE_EMAILS=
CISO_APPROVER_EMAIL=
CISO_APPROVER_NAME=
OUTBOX_POLL_SECONDS=30
WORKER_POLL_SECONDS=30
# 32 byte base64. Juga mengenkripsi kunci 2FA: JANGAN diganti setelah dipakai.
# Buat:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OUTBOX_ENCRYPTION_KEY=<base64-32-byte-key>

# --- Keamanan login -----------------------------------------------------------
# Verifikasi 2 langkah dengan aplikasi authenticator. on (disarankan) / off.
LOGIN_2FA=on
# Sesi dicocokkan ulang dengan AD tiap N menit (akun nonaktif = keluar). 0 = mati.
SESSION_RECHECK_MINUTES=5
# Sesi berakhir setelah sekian menit tidak dipakai, dan paling lama 8 jam.
SESSION_IDLE_TTL_MINUTES=120
SESSION_ABSOLUTE_TTL_MINUTES=480
APPROVAL_TOKEN_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=https://<nama-host-portal>

# --- Penyimpanan (di dalam volume hc-data) -----------------------------------
HC_DATA_FILE=/app/data/hc-store.json
HC_SESSION_FILE=/app/data/hc-sessions.json
HC_MFA_FILE=/app/data/hc-mfa.json
HC_SECURITY_LOG_FILE=/app/data/hc-security-log.jsonl
USER_FOLDER_ROOT=/app/data/user-folders
