# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas

# ---------------------------------------------------------------------------
# Session (JWT)
# ---------------------------------------------------------------------------
# Signs the login session cookie. Use a random value with at least 32 chars.
# This is the ONLY variable required to run the portal.
JWT_SECRET=your-long-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# ---------------------------------------------------------------------------
# Active Directory (LDAP) login
# ---------------------------------------------------------------------------
# Leave LDAP_URL unset in local development: the portal then falls back to the
# demo accounts in src/lib/auth/devUsers.ts (admin / admin12345). That fallback
# is refused in production — set a real LDAP_URL before deploying.
#
# LDAP_URL       the AD server, e.g. ldap://ad.corp.example.com:389
#                (use ldaps://...:636 for TLS, recommended).
# LDAP_DOMAIN    the UPN domain appended to a bare username, e.g. corp.example.com
#                so "budi" binds as budi@corp.example.com.
# LDAP_BASE_DN   where to search for the user record, e.g. DC=corp,DC=example,DC=com
# LDAP_ADMIN_GROUP  users in this group get the ADMIN role; everyone else is USER.
#                Matched against each memberOf value (case-insensitive substring),
#                e.g. CN=HC Admins,OU=Groups,DC=corp,DC=example,DC=com
# LDAP_URL=ldaps://ad.corp.example.com:636
# LDAP_DOMAIN=corp.example.com
# LDAP_BASE_DN=DC=corp,DC=example,DC=com
# LDAP_ADMIN_GROUP=CN=HC Admins,OU=Groups,DC=corp,DC=example,DC=com

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://portal.your-company.com

# ---------------------------------------------------------------------------
# Application URLs and local storage
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
# The employee directory is a JSON file (no database).
HC_DATA_FILE=data/hc-store.json
