# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_LOGO=/brand/logo.svg
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas

# ---------------------------------------------------------------------------
# Database (Prisma + PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/hc_user_management?schema=public

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Use a random value with at least 32 characters.
JWT_SECRET=your-long-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# ---------------------------------------------------------------------------
# Email: account notifications and access approvals
# ---------------------------------------------------------------------------
# One of: gmail | smtp | sendgrid. Leave unset only in local development: mail
# is printed to the server log there, but production refuses that fallback.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
# EMAIL_HOST=smtp.your-company.com
# EMAIL_PORT=587
# SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=HC Portal <no-reply@your-company.com>

# Approval links are single-use and expire after this many hours.
APPROVAL_LINK_TTL_HOURS=72

# A shared inbox for provisioning, access changes, and access removal.
SECURITY_TEAM_NAME=Tim CISO Cyber Security
SECURITY_TEAM_EMAIL=ciso-team@your-company.com

# ---------------------------------------------------------------------------
# First admin (read only by `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@your-company.com
ADMIN_PASSWORD=change-this-immediately
ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://portal.your-company.com

# ---------------------------------------------------------------------------
# Application URLs and local storage
# ---------------------------------------------------------------------------
# Used to generate links in approval, verification, and reset emails.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
HC_DATA_FILE=data/hc-store.json

# ---------------------------------------------------------------------------
# Approval workflow (register-with-approval)
# ---------------------------------------------------------------------------
# Email is sent with Nodemailer through Gmail. EMAIL_PASSWORD must be a Google
# App Password (https://myaccount.google.com/apppasswords, needs 2-Step
# Verification), not the account password.
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-16-char-app-password

# While TEST_MODE=true every outgoing email goes to TEST_RECIPIENT instead,
# with the intended recipient shown in the subject and a banner. Set it to
# false in production.
TEST_MODE=true
TEST_RECIPIENT=colecbened@gmail.com

# How long manager and CISO approval links stay valid: 30m, 24h, 7d.
APPROVAL_TOKEN_EXPIRY=24h

# Alternative to Gmail when an App Password is not possible: Resend
# (https://resend.com, sign in with Google, then API Keys -> Create).
# Sends over HTTPS, so networks that block SMTP ports do not matter. Without a
# verified domain it only delivers to the address the Resend account was
# created with, so sign up with the TEST_RECIPIENT address.
# EMAIL_SERVICE=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Recommended for sending to ANY recipient without owning a domain: Brevo
# (https://www.brevo.com, free 300 emails/day). Values come from
# SMTP & API -> SMTP in the Brevo dashboard. EMAIL_USER is the SMTP login
# (xxxx@smtp-brevo.com), EMAIL_PASSWORD is the SMTP key, and EMAIL_FROM is
# the address the Brevo account was created with.
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=xxxxxxxx@smtp-brevo.com
# EMAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxx
# EMAIL_FROM=HC Portal <you@example.com>
# TEST_MODE=false
