# ---------------------------------------------------------------------------
# Jira Cloud connection
# ---------------------------------------------------------------------------
# Your site host, without the scheme.
JIRA_DOMAIN=your-company.atlassian.net
# The Atlassian account the tickets are raised as.
JIRA_EMAIL=your-service-account@your-company.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token
# Project the onboarding tickets are created in.
JIRA_PROJECT_KEY=HC

# Leave unset to auto-detect: the app falls back to an in-memory mock Jira
# whenever the four variables above are missing or still hold placeholders.
# Set to "false" to require a real connection, or "true" to force the mock.
# JIRA_MOCK=false

# ---------------------------------------------------------------------------
# Issue types and assignees
# ---------------------------------------------------------------------------
JIRA_MANAGER_ISSUE_TYPE=Task
JIRA_SECURITY_ISSUE_TYPE=Task
# Jira accountId of the IT Security team account that provisioning tickets are
# assigned to. Find it at /rest/api/3/user/search?query=<email>.
JIRA_SECURITY_ACCOUNT_ID=your-it-security-account-id

# ---------------------------------------------------------------------------
# Status mapping (comma-separated, matched case-insensitively)
# ---------------------------------------------------------------------------
# Manager ticket statuses that approve the request.
JIRA_APPROVED_STATUSES=Approved,Done
# Manager ticket statuses that reject it.
JIRA_REJECTED_STATUSES=Rejected,Declined
# IT Security ticket statuses that mean provisioning is finished.
JIRA_SECURITY_DONE_STATUSES=Done,Closed,Resolved

# ---------------------------------------------------------------------------
# Webhook
# ---------------------------------------------------------------------------
# Shared secret Jira must present as ?secret=... or the x-hc-webhook-secret
# header on POST /api/webhooks/jira. Unset disables the check (local dev only).
JIRA_WEBHOOK_SECRET=your-webhook-shared-secret

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Used to deep-link Jira tickets back into this dashboard.
APP_BASE_URL=http://localhost:3000
# Where the JSON store is written (relative paths resolve from the repo root).
HC_DATA_FILE=data/hc-store.json
