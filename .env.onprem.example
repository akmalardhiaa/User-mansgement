# Template AD on-premise untuk PC kantor (uji coba): salin isinya ke .env.local.
#
# Server internal TIDAK memakai berkas ini: di sana portal berjalan sebagai
# Windows Service dalam mode production, dengan pengaturan yang hanya berlaku
# di production. Templatenya deploy/windows/env.production.example, disalin
# menjadi .env.production.local - lihat deploy/windows/README.md.
#
# Dulu ada .env.pilot.example terpisah, dan 28 dari 29 kuncinya identik dengan
# berkas ini. Bedanya cuma kapan AD_LDAP_WRITE_ENABLED dinyalakan — dan itu
# bukan alasan untuk punya dua berkas yang harus diperbarui berdua.
#
# Ganti setiap placeholder dengan nilai yang disetujui tim AD dan infrastruktur.
# Jangan pernah menaruh kredensial sungguhan di template ini atau di git.
#
# Urutan pengisiannya ada di MENJALANKAN.md Bagian 2. Jangan melompat ke
# AD_LDAP_WRITE_ENABLED=true sebelum `npm run ad:service-check` lolos.

APP_BASE_URL=https://hc.example.internal
NEXT_PUBLIC_BRAND_LOGO=/brand/mandiri-sekuritas-lockup.png
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas

# User login and service-account writes must reach the same trusted DC over LDAPS.
LDAP_URL=ldaps://dc.example.internal:636
AD_LDAP_URL=ldaps://dc.example.internal:636
LDAP_DOMAIN=example.internal
LDAP_BASE_DN=DC=example,DC=internal
AD_BASE_DN=DC=example,DC=internal
LDAP_CA_CERT_PATH=C:\certs\corp-root-ca.pem
LDAP_NESTED_GROUPS=false

# Empty until the read-only checks and OU pilot are approved.
AD_DRIVER=ldap
AD_LDAP_WRITE_ENABLED=false
AD_BIND_DN=CN=svc-hc-portal,OU=Service Accounts,DC=example,DC=internal
AD_BIND_PASSWORD=
AD_MANAGED_OUS=
AD_QUARANTINE_OU=

# Portal roles come from these groups. Managers/CISO approvers act from email,
# not by signing in to the HC portal.
AD_GROUP_HC=
AD_GROUP_ADMIN=
AD_GROUP_OPS=
AD_GROUP_AUDITOR=

# Account OUs and group catalogue. Keep each target aligned with the OU allowlist.
AD_OU_STANDARD=
AD_OU_ENGINEERING=
AD_OU_FINANCE=
AD_OU_SECURITY=
AD_ACCESS_GROUP_BASE=
AD_ACCESS_GROUP_ENGINEERING=
AD_ACCESS_GROUP_FINANCE=
AD_ACCESS_GROUP_SECURITY=

# OU per divisi (opsional): Divisi=>DN OU;Divisi=>DN OU, dan/atau OU induk yang
# berisi satu OU per divisi dengan nama yang sama. Kosong = semua ke
# AD_OU_STANDARD. Penjelasan lengkap di .env.example.
AD_DEPARTMENT_OUS=
AD_DEPARTMENT_OU_PARENT=

# Approval email and outbox protection. Use a real company relay in production.
EMAIL_DRIVER=smtp
EMAIL_REDIRECT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER=
SMTP_PASSWORD=
CISO_APPROVER_GROUP=
CISO_APPROVER_EMAILS=
CISO_EXCLUDE_EMAILS=
CISO_APPROVER_EMAIL=
CISO_APPROVER_NAME=
OUTBOX_POLL_SECONDS=30
OUTBOX_ENCRYPTION_KEY=

# Durable local disk paths. Restrict NTFS ACLs to the portal service account
# and administrators; back up data/ daily. Run a single app instance only.
HC_DATA_FILE=C:\HC\UserManagement\data\hc-store.json
HC_SESSION_FILE=C:\HC\UserManagement\data\hc-sessions.json
USER_FOLDER_ROOT=C:\HC\EmployeeFolders
