# Demo defaults for `npm run dev` — the container reads this same file, so
# running with or without Podman gives the same portal.
#
# Committed on purpose, and safe to commit: every value here is a placeholder.
# Nothing in this file reaches a real mailbox, and no directory is configured
# at all.
#
# Next reads `.env.local` AFTER this file, so anything you put there wins. That
# is where the SMTP password and your own addresses belong — `.env*.local` is
# gitignored, this file is not.

# Must match the address you open in the browser. Every approval link in every
# email is built from it, so a mismatch produces mail whose buttons point at
# nothing.
APP_BASE_URL=http://localhost:3000

# Where the portal keeps the roster, the sessions and the file-driver outbox.
# Relative to the project folder.
HC_DATA_FILE=data/hc-store.json

NEXT_PUBLIC_BRAND_LOGO=/brand/mandiri-sekuritas-lockup.png
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas

# No directory. AD_DRIVER is left unset on purpose: the simulated directory is
# gone, and there is nothing to point it at without a real one. Sign-in uses
# the local demo accounts (src/lib/auth/devUsers.ts); requests can be filed and
# approved from email; the worker carries out nothing until AD_DRIVER=ldap and
# its configuration are put in .env.local — template: .env.onprem.example.
#
# Email is written to files under data/outbox-mail/ rather than sent.
EMAIL_DRIVER=file

# The demo accounts (admin / admin12345) are asked for by name, here, on the
# laptop. They no longer switch themselves on when the AD address is missing:
# an office .env with a blank AD line opened the portal to them. Production
# refuses them whatever this says.
DEMO_LOGIN=on

# Two-step verification is on unless switched off: LOGIN_2FA=off. The first
# sign-in shows a QR code for Microsoft or Google Authenticator. Switch it off
# in .env.local (or .env.podman) for a demo without a phone.
# LOGIN_2FA=off

# Where approval mail would go if EMAIL_DRIVER were switched to smtp. A
# placeholder rather than an empty value: a stray SMTP run then bounces instead
# of reaching somebody who never asked to be in a demo.
EMAIL_REDIRECT_TO=ganti-dengan-email-anda@example.com

CISO_APPROVER_EMAIL=ganti-dengan-email-ciso@example.com
CISO_APPROVER_NAME=Approver CISO

# How often the outbox is swept. The worker has its own, WORKER_POLL_SECONDS,
# which defaults to 30 outside production.
OUTBOX_POLL_SECONDS=30
