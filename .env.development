# Demo defaults for `npm run dev` — the same set the container gets from
# .env.docker.example, so running with or without Docker gives the same portal.
#
# Committed on purpose, and safe to commit: every value here is a placeholder or
# a simulated directory. Nothing in this file reaches a real mailbox or a real
# domain controller.
#
# Next reads `.env.local` AFTER this file, so anything you put there wins. That
# is where the SMTP password and your own addresses belong — `.env*.local` is
# gitignored, this file is not.

# Must match the address you open in the browser. Every approval link in every
# email is built from it, so a mismatch produces mail whose buttons point at
# nothing.
APP_BASE_URL=http://localhost:3000

# Where the portal keeps the roster, the sessions, the simulated directory and
# the file-driver outbox. Relative to the project folder.
HC_DATA_FILE=data/hc-store.json

NEXT_PUBLIC_BRAND_LOGO=/brand/mandiri-sekuritas-lockup.png
NEXT_PUBLIC_BRAND_NAME=Mandiri Sekuritas

# Sign in with the accounts in the simulated directory, so login exercises the
# same group-to-role mapping a real domain controller would.
MOCK_AD_LOGIN=true
MOCK_AD_PASSWORD=mock12345

# The group that grants portal access. The first run gives it to Human Capital,
# so `ayu.prameswari` can sign in; see src/lib/ad/bootstrapMockAd.ts.
AD_GROUP_HC=CN=HC Officers,OU=Groups,DC=corp,DC=example,DC=com
AD_GROUP_ADMIN=CN=HC Portal Admins,OU=Groups,DC=corp,DC=example,DC=com

# A simulated directory, and email written to files under data/outbox-mail/
# rather than sent. Nothing leaves the machine with these two settings.
AD_DRIVER=mock
EMAIL_DRIVER=file

# Where approval mail would go if EMAIL_DRIVER were switched to smtp. A
# placeholder rather than an empty value: a stray SMTP run then bounces instead
# of reaching somebody who never asked to be in a demo.
EMAIL_REDIRECT_TO=ganti-dengan-email-anda@example.com

CISO_APPROVER_EMAIL=ganti-dengan-email-ciso@example.com
CISO_APPROVER_NAME=Approver CISO

# How often the outbox is swept. The worker has its own, WORKER_POLL_SECONDS,
# which defaults to 30 outside production.
OUTBOX_POLL_SECONDS=30
